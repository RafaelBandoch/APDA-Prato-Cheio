# PostgreSQL — obrigatório para rodar a aplicação e os testes.
# Copie este arquivo para .env e preencha com sua URL do Neon, Supabase ou instância local.
#
# Exemplos:
#   Neon:      postgres://user:senha@ep-xxx.neon.tech/dbname?sslmode=require
#   Supabase:  postgres://postgres:senha@db.xxx.supabase.co:5432/postgres
#   Local:     postgres://pratocheio:pratocheio@localhost:5432/pratocheio
#   Docker:    postgres://postgres:postgres@localhost:5432/postgres

DATABASE_URL=postgres://user:senha@host:5432/dbname
